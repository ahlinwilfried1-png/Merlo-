<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f8fafc"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#d97706"/>
      <stop offset="50%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#b45309"/>
    </linearGradient>
    <linearGradient id="emeraldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#059669"/>
      <stop offset="100%" stop-color="#047857"/>
    </linearGradient>
  </defs>

  <!-- Background Document -->
  <rect x="0" y="0" width="1200" height="800" fill="url(#bgGrad)" rx="24"/>
  <rect x="20" y="20" width="1160" height="760" fill="none" stroke="#e2e8f0" stroke-width="2" rx="18"/>
  <rect x="30" y="30" width="1140" height="740" fill="none" stroke="#cbd5e1" stroke-dasharray="8 6" stroke-width="1.5" rx="14"/>

  <!-- Top Header Ribbon -->
  <rect x="60" y="60" width="1080" height="100" fill="#0f172a" rx="16"/>
  <text x="600" y="105" fill="#f8fafc" font-family="system-ui, -apple-system, sans-serif" font-size="24" font-weight="bold" text-anchor="middle" letter-spacing="2">
    ACCORD STRATÉGIQUE DE COOPÉRATION &amp; PARTENARIAT OFFICIEL
  </text>
  <text x="600" y="138" fill="#34d399" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle" letter-spacing="3">
    CONSORTIUM AGRO-INDUSTRIEL &amp; DISTRIBUTION TECHNOLOGIQUE VIP
  </text>

  <!-- Contract Reference & Legal Status -->
  <rect x="60" y="180" width="1080" height="50" fill="#ecfdf5" stroke="#a7f3d0" stroke-width="1.5" rx="10"/>
  <text x="80" y="210" fill="#065f46" font-family="system-ui, sans-serif" font-size="14" font-weight="bold">
    CONTRAT N° : AGRO-VIP-2026-REG-0984
  </text>
  <text x="600" y="210" fill="#047857" font-family="system-ui, sans-serif" font-size="13" text-anchor="middle">
    Statut : CERTIFIÉ &amp; ENREGISTRÉ • EXPLOITATIONS VALIDÉES
  </text>
  <text x="1120" y="210" fill="#065f46" font-family="monospace" font-size="13" font-weight="bold" text-anchor="end">
    MILLÉSIME 2026-2028
  </text>

  <!-- Partners Consortium Box -->
  <rect x="60" y="250" width="1080" height="150" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" rx="16"/>
  <text x="600" y="285" fill="#64748b" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" text-anchor="middle" letter-spacing="2">
    ENTREPRISES &amp; GROUPES AGRO-INDUSTRIELS SIGNATAIRES
  </text>

  <!-- Partner Logos / Badges -->
  <!-- Nutrien -->
  <g transform="translate(100, 310)">
    <rect width="160" height="60" rx="12" fill="#f0fdf4" stroke="#86efac" stroke-width="1.5"/>
    <text x="80" y="32" fill="#15803d" font-family="system-ui, sans-serif" font-size="16" font-weight="900" text-anchor="middle">Nutrien</text>
    <text x="80" y="48" fill="#166534" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Ag Solutions</text>
  </g>

  <!-- Bayer -->
  <g transform="translate(280, 310)">
    <rect width="160" height="60" rx="12" fill="#eff6ff" stroke="#93c5fd" stroke-width="1.5"/>
    <text x="80" y="32" fill="#1d4ed8" font-family="system-ui, sans-serif" font-size="16" font-weight="900" text-anchor="middle">BAYER</text>
    <text x="80" y="48" fill="#1e40af" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Crop Science</text>
  </g>

  <!-- Corteva -->
  <g transform="translate(460, 310)">
    <rect width="160" height="60" rx="12" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5"/>
    <text x="80" y="32" fill="#0f172a" font-family="system-ui, sans-serif" font-size="15" font-weight="900" text-anchor="middle">CORTEVA</text>
    <text x="80" y="48" fill="#475569" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Agriscience</text>
  </g>

  <!-- Syngenta -->
  <g transform="translate(640, 310)">
    <rect width="160" height="60" rx="12" fill="#ecfeff" stroke="#a5f3fc" stroke-width="1.5"/>
    <text x="80" y="32" fill="#0e7490" font-family="system-ui, sans-serif" font-size="16" font-weight="900" text-anchor="middle">syngenta</text>
    <text x="80" y="48" fill="#155e75" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Global Farm Group</text>
  </g>

  <!-- Yara -->
  <g transform="translate(820, 310)">
    <rect width="140" height="60" rx="12" fill="#fdf4ff" stroke="#f0abfc" stroke-width="1.5"/>
    <text x="70" y="32" fill="#a21caf" font-family="system-ui, sans-serif" font-size="16" font-weight="900" text-anchor="middle">YARA</text>
    <text x="70" y="48" fill="#86198f" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">International</text>
  </g>

  <!-- ADM -->
  <g transform="translate(980, 310)">
    <rect width="120" height="60" rx="12" fill="#fffbeb" stroke="#fde68a" stroke-width="1.5"/>
    <text x="60" y="32" fill="#b45309" font-family="system-ui, sans-serif" font-size="16" font-weight="900" text-anchor="middle">ADM</text>
    <text x="60" y="48" fill="#92400e" font-family="system-ui, sans-serif" font-size="10" font-weight="bold" text-anchor="middle">Agriculture Co</text>
  </g>

  <!-- Agreement Clauses & Scope -->
  <rect x="60" y="420" width="1080" height="190" fill="#f8fafc" stroke="#e2e8f0" rx="16"/>
  <text x="90" y="455" fill="#0f172a" font-family="system-ui, sans-serif" font-size="15" font-weight="bold">
    CLAUSES DU PROGRAMME ET ENGAGEMENT DES PARTIES :
  </text>

  <text x="90" y="485" fill="#334155" font-family="system-ui, sans-serif" font-size="13">
    1. <tspan font-weight="bold">Déploiement Technologique :</tspan> Mise à disposition d'équipements mécanisés, serres hydroponiques et semences bio certifiées.
  </text>
  <text x="90" y="515" fill="#334155" font-family="system-ui, sans-serif" font-size="13">
    2. <tspan font-weight="bold">Garantie des Rendements :</tspan> Sécurisation des revenus quotidiens 24h/24 et traçabilité transparente des forfaits VIP utilisateurs.
  </text>
  <text x="90" y="545" fill="#334155" font-family="system-ui, sans-serif" font-size="13">
    3. <tspan font-weight="bold">Liquidité et Retraits :</tspan> Couverture à 100% des demandes de retrait via passerelles Mobile Money et intégration bancaire.
  </text>
  <text x="90" y="575" fill="#334155" font-family="system-ui, sans-serif" font-size="13">
    4. <tspan font-weight="bold">Audit &amp; Conformité :</tspan> Respect strict des normes environnementales, sociétales et financières sous-régionales.
  </text>

  <!-- Bottom Signatures & Seal -->
  <!-- Official Gold Stamp -->
  <g transform="translate(100, 635)">
    <circle cx="50" cy="50" r="45" fill="url(#goldGrad)" stroke="#78350f" stroke-width="2"/>
    <circle cx="50" cy="50" r="38" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4 2"/>
    <text x="50" y="44" fill="#ffffff" font-family="system-ui, sans-serif" font-size="10" font-weight="900" text-anchor="middle">OFFICIAL</text>
    <text x="50" y="58" fill="#ffffff" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" text-anchor="middle">SEAL</text>
    <text x="50" y="70" fill="#ffffff" font-family="monospace" font-size="8" text-anchor="middle">2026-2028</text>
  </g>

  <!-- Signature 1 -->
  <g transform="translate(250, 645)">
    <line x1="0" y1="50" x2="220" y2="50" stroke="#94a3b8" stroke-width="1.5"/>
    <path d="M 10 40 Q 60 10 110 35 T 200 20" fill="none" stroke="#0f172a" stroke-width="2.5"/>
    <text x="110" y="68" fill="#0f172a" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Dr. Aris Thorne</text>
    <text x="110" y="82" fill="#64748b" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle">Direction Générale Nutrien Ag</text>
  </g>

  <!-- Signature 2 -->
  <g transform="translate(560, 645)">
    <line x1="0" y1="50" x2="220" y2="50" stroke="#94a3b8" stroke-width="1.5"/>
    <path d="M 10 30 Q 80 50 140 25 T 210 38" fill="none" stroke="#047857" stroke-width="2.5"/>
    <text x="110" y="68" fill="#0f172a" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" text-anchor="middle">Marcello Vance</text>
    <text x="110" y="82" fill="#64748b" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle">VP Opérations Internationales Bayer</text>
  </g>

  <!-- Signature 3 / Stamp -->
  <g transform="translate(860, 635)">
    <rect width="260" height="90" rx="12" fill="#ecfdf5" stroke="#10b981" stroke-width="2"/>
    <text x="130" y="32" fill="#047857" font-family="system-ui, sans-serif" font-size="11" font-weight="900" text-anchor="middle" letter-spacing="1">
      APPROUVÉ ET ENREGISTRÉ
    </text>
    <text x="130" y="52" fill="#065f46" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">
      CONFORMITÉ ROYALE &amp; AGRO-FINTECH
    </text>
    <text x="130" y="70" fill="#059669" font-family="system-ui, sans-serif" font-size="10" text-anchor="middle">
      Validé pour diffusion publique
    </text>
  </g>
</svg>
